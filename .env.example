# Server port
PORT=3000

# Admin token used by the /admin route. Example: ADMIN_TOKEN=changeme
# For production use a signed expiring token or proper admin authentication.
ADMIN_TOKEN=changeme

# Telegram bot token (required for Telegram admin control)
# Format: 123456:ABC-DEF... (from BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram chat id where admin notifications are sent (group or user id)
# Example: -1001234567890 for groups, or 123456789 for individual user
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Optional: webhook secret path segment (recommended). If set, your webhook URL should include it.
# Example when set: https://your-domain/telegram/webhook/your-secret
TELEGRAM_WEBHOOK_SECRET=optional-secret
